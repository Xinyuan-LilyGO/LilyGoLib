{
  "name": "LilyGoLib",
  "version": "0.3.0",
  "description": "LilyGo Arduino library",
  "keywords": "lilygo,t-watch,t-lora-pager",
  "authors": [
    {
      "name": "LewisHe",
      "url": "https://github.com/lewisxhe",
      "maintainer": true
    },
    {
      "name": "Xinyuan-LilyGO",
      "url": "https://github.com/Xinyuan-LilyGO"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xinyuan-LilyGO/LilyGoLib.git"
  },
  "homepage": "https://github.com/Xinyuan-LilyGO",
  "export": {
    "include": [
      "LICENSE",
      "library.json",
      "library.properties",
      "README.MD",
      "platformio.ini",
      "keywords.txt",
      "arduino/*",
      "boards/*",
      "variants/*",
      "scripts/*",
      "src/*",
      "examples/*"
    ]
  },
  "dependencies": {
    "lvgl/lvgl": "9.6.0",
    "jgromes/RadioLib": "7.7.1",
    "lewisxhe/SensorLib": "0.5.2",
    "lennarthennigs/Button2": "2.7.0",
    "adafruit/Adafruit PN532": "1.3.4",
    "adafruit/Adafruit BusIO": "1.17.4",
    "adafruit/Adafruit TCA8418": "1.0.2",
    "lewisxhe/ST25R3916-NFC-RFAL": "1.0.1",
    "pu2clr/PU2CLR SI4735": "2.1.8"
  },
  "examples": ["examples/*/*.ino"],
  "frameworks": ["arduino"],
  "platforms": "esp32",
  "headers": "LilyGoLib.h"
}
